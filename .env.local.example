# Get your API key from https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=re_your_key_here

# Verified sending address, required to email a drafted letter TO a visitor.
# Without it the demo still captures the lead and notifies the team.
RESEND_FROM_EMAIL=hello@yeam.ai

# Shared secret for the appeal demo. Must match PUBLIC_DEMO_SECRET in the
# yeam_agent_system project — the drafting itself runs there.
PUBLIC_DEMO_SECRET=must-match-the-app

# Override the app origin the demo forwards to. Defaults to https://app.yeam.ai.
# YEAM_APP_URL=http://localhost:3005

# Cloudflare Turnstile. When unset, bot verification is skipped entirely and
# the per-IP rate limit is the only guard on the public drafting endpoint.
# TURNSTILE_SECRET_KEY=
